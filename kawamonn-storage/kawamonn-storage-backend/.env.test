# Throwaway credentials for the LOCAL/CI ephemeral test database only.
# Loaded by test/setup-e2e.ts (via dotenv) for `npm run test:e2e`, and also by
# .github/workflows/ci.yml (via `grep >> $GITHUB_ENV`) — never used by the
# real app (main.ts), which reads the real .env instead.
# Intentionally different port/db-name from production so this can never be
# confused with the real DATABASE_URL in .env.
# Values are intentionally UNQUOTED: $GITHUB_ENV expects raw KEY=VALUE with no
# shell-style quote removal, so a quoted value here would end up with literal
# quote characters baked into the env var in CI (this broke DATABASE_URL once
# already — dotenv strips quotes locally, masking the problem there).
DATABASE_URL=postgresql://test:test@localhost:5433/kawamonn_test?schema=public
JWT_SECRET=ci-only-throwaway-secret-not-real-0000
REDIS_HOST=localhost
REDIS_PORT=6380
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=test-access-key
MINIO_SECRET_KEY=test-secret-key
MINIO_BUCKET=test-bucket
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@example.com
SMTP_PASS=test-throwaway
